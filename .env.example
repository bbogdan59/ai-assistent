# --- Server ---
PORT=3000

# --- WhatsApp Cloud API (Meta for Developers) ---
WHATSAPP_TOKEN=your_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# Any string you choose; must match what you enter in the Meta webhook config
WHATSAPP_VERIFY_TOKEN=choose_a_random_verify_token
# Found in App Dashboard > App Settings > Basic. Used to verify webhook signatures.
WHATSAPP_APP_SECRET=your_app_secret
# Log the full raw webhook JSON while you confirm the real group-message shape (see README)
DEBUG_LOG_RAW_WEBHOOKS=true

# --- Bot behavior ---
# The name people use in the group to address the bot, e.g. "Ana, what's on tonight?"
BOT_NAME=Ana
# IANA timezone used to interpret "today"/"tonight"/etc.
TIMEZONE=Europe/Bucharest
# How many days back the monthly recap looks
DIGEST_LOOKBACK_DAYS=30
# Cron expression (server time is UTC in Docker) for the automatic monthly recap
DIGEST_CRON=0 8 1 * *

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-sonnet-5

# --- Google Calendar (OAuth2, personal account) ---
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# Obtained once via `npm run auth:google`
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
# Comma-separated name:calendarId pairs. Calendar ID is under
# Google Calendar > Settings > [calendar] > Integrate calendar > Calendar ID
CALENDARS=church:your_church_calendar_id@group.calendar.google.com,personal:your_email@gmail.com
# Which entry in CALENDARS to use when the user doesn't name one
DEFAULT_CALENDAR=church

# --- Database (Railway's Postgres plugin sets this automatically) ---
DATABASE_URL=postgres://user:password@host:5432/dbname
